# =============================================================================
# AI Context Framework — .gitignore
# =============================================================================
# Personal AI context is NEVER committed to source control.
# The .ai_local/ directory is developer-owned working memory.
# =============================================================================

# Tier 3 developer-local AI working memory — gitignored by contract
.ai_local/

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor artifacts
.vscode/settings.json
*.swp
*.swo
*~

# Logs
*.log

# Environment files — NEVER commit these
.env
.env.*
*.env

# Secrets — NEVER commit these
secrets.*
*.secrets
credentials.*
*.credentials
# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: local machine markers & runtime process state (never commit)
.squad/.first-run
.squad/.watch-pids
.squad/.watch-pids/
# Squad: governed-memory runtime state (audit/index/inboxes are ephemeral; keep memory/config.json)
.squad/memory/audit.jsonl
.squad/memory/index.json
.squad/memory/local/
.squad/memory/policy-inbox/
.squad/memory/semantic-inbox/
.squad/memory/tombstones/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
